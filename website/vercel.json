{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(install.ps1|install.sh|version.json)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=0, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/website",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/privacy",
      "destination": "/privacy_policy.html",
      "permanent": true
    },
    {
      "source": "/website/:path*",
      "destination": "/:path*",
      "permanent": true
    },
    {
      "source": "/PCDeck-Setup.exe",
      "destination": "https://github.com/greson719/pcdeck/releases/latest/download/PCDeck-Setup.exe",
      "permanent": false
    },
    {
      "source": "/PCDeck.exe",
      "destination": "https://github.com/greson719/pcdeck/releases/latest/download/PCDeck.exe",
      "permanent": false
    },
    {
      "source": "/PCDeck_Package.zip",
      "destination": "https://github.com/greson719/pcdeck/releases/latest/download/PCDeck_Package.zip",
      "permanent": false
    },
    {
      "source": "/PCDeck.apk",
      "destination": "https://github.com/greson719/pcdeck/releases/latest/download/PCDeck.apk",
      "permanent": false
    }
  ]
}
