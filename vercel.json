{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/website",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/website/:path*",
      "destination": "/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/PCDeck-Setup.exe",
      "destination": "/api/download"
    }
  ]
}
